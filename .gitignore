# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/

# Secrets — never commit .env files; only the .env.example template is tracked
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store

# Coverage / build
.coverage
htmlcov/
dist/
build/

# Local agent state (logs, cached responses outside test fixtures)
.atlas/
logs/
local/

# Rust TUI build output
tui/target/

# Exported model weights (ATLAS_WEIGHTS_DIR or <repo>/weights)
weights/*
!weights/.gitkeep

CLAUDE.md
AGENTS.md
